# ============================================================
# KONFIGURASI LIVE STREAM YOUTUBE (1080p 24/7)
# ============================================================

# YouTube Stream Key (Dapatkan di YouTube Studio -> Create -> Go Live)
STREAM_KEY="xxxx-xxxx-xxxx-xxxx-xxxx"

# RTMP URL Server YouTube
# Default rtmp: rtmp://a.rtmp.youtube.com/live2
# Atau rtmps : rtmps://a.rtmp.youtube.com/live2
RTMP_URL="rtmp://a.rtmp.youtube.com/live2"

# File Video Background Looping
# Biarkan kosong ("") untuk otomatis mencari file video pertama di folder video/ atau folder saat ini.
# Contoh jika ingin ditentukan manual: "video/sample_background.mp4"
VIDEO_FILE=""

# Volume Audio Video (0.0 = Mute/0%, 1.0 = 100%, 0.5 = 50%, dst.)
VIDEO_VOLUME="0.0"

# Folder Playlist Musik
# Masukkan file-file musik Anda (.mp3, .m4a, .wav, .flac, .ogg, .opus) ke folder ini.
MUSIC_DIR="music"

# Volume Audio Playlist Musik (1.0 = 100%, 0.5 = 50%, dst.)
MUSIC_VOLUME="1.0"

# Mode Urutan Playlist Musik:
# "shuffle"      : Acak urutan lagu setiap putaran
# "alphabetical" : Urut nama file dari A ke Z
# "reverse"      : Urut nama file terbalik dari Z ke A
# "custom"       : Urutan kustom dari file playlist.txt
PLAYLIST_MODE="shuffle"

# File Playlist untuk mode kustom
PLAYLIST_FILE="playlist.txt"

# Putar playlist secara acak (kompatibilitas mundur)
SHUFFLE_PLAYLIST="true"

# Resolusi & Frame Rate Video (1080p 30fps)
VIDEO_WIDTH="1920"
VIDEO_HEIGHT="1080"
VIDEO_FPS="30"

# Bitrate Video (3500k - 4500k sangat ideal untuk 1080p 30fps)
VIDEO_BITRATE="3500k"
VIDEO_MAXRATE="4000k"
VIDEO_BUFSIZE="7000k"

# Preset CPU Encoder x264 (ultrafast / superfast / veryfast)
# Rekomendasi di HP / Termux: "ultrafast" (paling ringan, hemat baterai, anti lag / dropped frame)
ENCODER_PRESET="ultrafast"

# Kualitas Audio (AAC Stereo)
AUDIO_BITRATE="128k"
AUDIO_SAMPLERATE="44100"

# Auto Reconnect (otomatis menghubungkan ulang jika sinyal / internet sempat putus)
AUTO_RECONNECT="true"
RECONNECT_DELAY="5"
